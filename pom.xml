<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.l9g.webjars</groupId>
  <artifactId>webjars-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>de.l9g WebJars Parent</name>
  <description>Aggregator and parent POM for the de.l9g.webjars modules (AdminLTE, jsVectorMap, Source Sans 3).</description>
  <url>https://github.com/thorsten-l/l9g-webjars</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Thorsten Ludewig</name>
      <email>t.ludewig@gmail.com</email>
      <organization>L9G</organization>
      <organizationUrl>https://github.com/thorsten-l</organizationUrl>
      <roles>
        <role>Maintainer</role>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:thorsten-l/l9g-webjars.git</connection>
    <developerConnection>scm:git:git@github.com:thorsten-l/l9g-webjars.git</developerConnection>
    <url>https://github.com/thorsten-l/l9g-webjars</url>
  </scm>

  <modules>
    <module>adminlte-webjar</module>
    <module>jsvectormap-webjar</module>
    <module>source-sans-3-webjar</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <!-- Overridden per module; used in the OSGi/WebJar manifest below. -->
    <webjar.license>MIT</webjar.license>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Implementation-Title>${project.artifactId}</Implementation-Title>
                <Implementation-Version>${project.version}</Implementation-Version>
                <Implementation-Vendor>de.l9g</Implementation-Vendor>
                <Bundle-ManifestVersion>2</Bundle-ManifestVersion>
                <Bundle-Name>${project.name}</Bundle-Name>
                <Bundle-SymbolicName>de.l9g.webjars.${project.artifactId}</Bundle-SymbolicName>
                <Bundle-Version>${project.version}</Bundle-Version>
                <Bundle-License>${webjar.license}</Bundle-License>
                <Bundle-DocURL>${project.url}</Bundle-DocURL>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.10.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>ossrh</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
</project>
